# shellcheck shell=bash
#
# Local Apple Silicon evaluation profile. This file contains no secrets.

ENVIRONMENT_NAME="local-arm64"
ARCHITECTURE="aarch64"
HOST_PROVIDER="lima"
EXPECTED_ANSIBLE_ARCHITECTURES="aarch64,arm64"

CONTROLLER_NAME="osk8s-controller"
COMPUTE_NAME="osk8s-compute"
COMPUTE_NAMES=("osk8s-compute")
COMPUTE_INVENTORY_NAMES=("compute01")
COMPUTE_NODE_HOSTNAMES=("osk8s-compute")
COMPUTE_MANAGEMENT_IPS=()
LIMA_NETWORK_NAME="osk8s-mgmt"
LIMA_MANAGEMENT_INTERFACE="lima0"
MANAGEMENT_INTERFACE="${LIMA_MANAGEMENT_INTERFACE}"
SOCKET_VMNET_VERSION="v1.2.2"

CONTROLLER_CPUS="4"
CONTROLLER_MEMORY_GIB="8"
CONTROLLER_DISK_GIB="80"
COMPUTE_CPUS="4"
COMPUTE_MEMORY_GIB="10"
COMPUTE_DISK_GIB="80"
GUEST_SWAP_GIB="2"

# Lima/VZ guests can retain a stale system clock across macOS sleep. These
# values are local bootstrap/readiness gates and must not be inherited by
# cloud or bare-metal profiles.
MAX_CLOCK_SKEW_SECONDS="5"
RTC_MINIMUM_EPOCH="1704067200"
NTP_SYNC_READY_TIMEOUT_SECONDS="120"

# Kubernetes node images are built in a short-lived Lima VM.  It must not run
# alongside the OpenStack controller/compute VMs on the 16 GiB local host.
IMAGE_BUILDER_NAME="osk8s-image-builder"
IMAGE_BUILDER_CPUS="4"
IMAGE_BUILDER_MEMORY_GIB="6"
IMAGE_BUILDER_DISK_GIB="50"

# These defaults are checked for route overlap before any VM is created.
MANAGEMENT_GATEWAY_CIDR="192.168.107.1/24"
MANAGEMENT_CIDR="192.168.107.0/24"
MANAGEMENT_DHCP_END="192.168.107.199"
KOLLA_INTERNAL_VIP_ADDRESS="192.168.107.250"

EXTERNAL_CIDR="172.24.4.0/24"
EXTERNAL_GATEWAY="172.24.4.1"
EXTERNAL_ALLOCATION_POOL_START="172.24.4.100"
EXTERNAL_ALLOCATION_POOL_END="172.24.4.199"
EXTERNAL_INTERFACE="veth-kolla-ex"
EXTERNAL_GATEWAY_INTERFACE="veth-kolla-gw"
EXTERNAL_PHYSNET="physnet1"
EXTERNAL_NETWORK_NAME="public"

TENANT_CIDR="10.10.0.0/24"
TENANT_GATEWAY="10.10.0.1"
TENANT_NETWORK_NAME="private"
TENANT_SUBNET_NAME="private-subnet"
TENANT_ROUTER_NAME="test-router"

KOLLA_SERIES="2025.2"
# GitHub is the official read-only mirror of the OpenDev repository.  Pin the
# exact stable/2025.2 commit so a rebuild cannot silently change deploy code.
KOLLA_GIT_URL="https://github.com/openstack/kolla-ansible.git"
KOLLA_GIT_REF="34daacfbf2d5987f543787f57535b2bebe7dee19"
KOLLA_COLLECTION_GIT_URL="https://github.com/openstack/ansible-collection-kolla.git"
KOLLA_COLLECTION_GIT_REF="e5c055a07f7fe8c7632ea67d964c28c2b33c7575"
# 2025.2 publishes the required aarch64 images for Debian Bookworm. The Lima
# hosts remain Ubuntu 24.04; this setting only selects the container base.
KOLLA_BASE_DISTRO="debian"
KOLLA_OPENSTACK_TAG_SUFFIX="-aarch64"
KOLLA_DEPLOY_DIR="/opt/openstack-k8s"
KOLLA_CONFIG_DIR="/etc/kolla"
KOLLA_VENV="/opt/kolla-venv"
KOLLA_GLOBALS_TEMPLATE="globals.yml.tpl"
KOLLA_BUILD_NOVA_LIBVIRT_OVERRIDE="yes"

# Kolla 2025.2's published Debian ARM64 nova-libvirt image omits
# dnsmasq-base because it installs packages without recommendations. Libvirt
# requires the binary even when OpenStack networks are managed by Neutron.
# Build a narrowly scoped local derivative and override only nova-libvirt.
KOLLA_NOVA_LIBVIRT_BASE_IMAGE="quay.io/openstack.kolla/nova-libvirt:2025.2-debian-bookworm-aarch64"
KOLLA_NOVA_LIBVIRT_IMAGE="openstack-k8s/nova-libvirt"
KOLLA_NOVA_LIBVIRT_TAG="2025.2-debian-bookworm-aarch64-dnsmasq1"

OPENSTACK_TEST_PROJECT="capi-test"
OPENSTACK_TEST_USER="capi-test"
OPENSTACK_TEST_FLAVOR="m1.local"
OPENSTACK_TEST_FLAVOR_VCPUS="1"
OPENSTACK_TEST_FLAVOR_RAM_MB="1024"
OPENSTACK_TEST_FLAVOR_DISK_GB="10"

CIRROS_VERSION="0.6.3"
CIRROS_IMAGE_NAME="cirros-0.6.3-aarch64"
CIRROS_IMAGE_URL="https://github.com/cirros-dev/cirros/releases/download/0.6.3/cirros-0.6.3-aarch64-disk.img"
CIRROS_SHA256_URL="https://github.com/cirros-dev/cirros/releases/download/0.6.3/SHA256SUMS"

UBUNTU_IMAGE_NAME="ubuntu-24.04-arm64"
UBUNTU_IMAGE_URL="https://cloud-images.ubuntu.com/releases/noble/release/ubuntu-24.04-server-cloudimg-arm64.img"
UBUNTU_SHA256_URL="https://cloud-images.ubuntu.com/releases/noble/release/SHA256SUMS"

# M1 Kubernetes image contract.  Image Builder is pinned by both release and
# commit because v0.1.55 is an annotated tag.
IMAGE_BUILDER_VERSION="v0.1.55"
IMAGE_BUILDER_COMMIT="7ffb9b7f1f26cd66891874463cc9411e3633325f"
KUBERNETES_VERSION="v1.35.7"
KUBERNETES_IMAGE_NAME="ubuntu-2204-kube-v1.35.7-arm64"
KUBERNETES_IMAGE_OS_VERSION="22.04"

KUBERNETES_CONTROL_PLANE_FLAVOR="k8s.control-plane.local"
KUBERNETES_CONTROL_PLANE_VCPUS="2"
KUBERNETES_CONTROL_PLANE_RAM_MB="2048"
KUBERNETES_CONTROL_PLANE_DISK_GB="20"

KUBERNETES_WORKER_FLAVOR="k8s.worker.local"
KUBERNETES_WORKER_VCPUS="2"
KUBERNETES_WORKER_RAM_MB="2048"
KUBERNETES_WORKER_DISK_GB="20"

PROBE_DOCKER_NETWORK="osk8s-capo-probe"
PROBE_API_PORT="6443"

# Local-only management cluster. The binary, node image and kubeconfig are
# pinned and kept under .state so this profile does not mutate global kubectl
# state. Cloud and bare-metal profiles must choose their own topology.
MANAGEMENT_CLUSTER_NAME="osk8s-management"
KIND_VERSION="v0.31.0"
KIND_DARWIN_ARM64_SHA256="88bf554fe9da6311c9f8c2d082613c002911a476f6b5090e9420b35d84e70c5c"
KIND_NODE_IMAGE="kindest/node:v1.35.0@sha256:452d707d4862f52530247495d180205e029056831160e22870e37e3f6c1ac31f"
KIND_KUBERNETES_VERSION="v1.35.0"

# M2 Cluster API/CAPO workload cluster contract.  All downloads and provider
# versions are pinned so a later upstream release cannot silently change the
# local feasibility result.
CLUSTER_API_VERSION="v1.13.4"
CLUSTERCTL_DARWIN_ARM64_SHA256="923f15e5d78c1fb161fc32aa0fb69065ba063c4fa619ce80c2dfbb18c21a3f47"
CAPO_VERSION="v0.14.6"
ORC_VERSION="v2.4.0"
ORC_INSTALL_SHA256="f27d81872499ff9df5aa0278843d56b9b4d96e63a1c5823ebfca8af43587196b"
CALICO_VERSION="v3.32.1"
CALICO_MANIFEST_SHA256="a1df919d9721cf667accdc3e72848911b0cb25cfab7d2478ad0c996302c95744"

WORKLOAD_NAMESPACE="osk8s-workload"
WORKLOAD_CLUSTER_NAME="osk8s-workload"
WORKLOAD_NETWORK_CIDR="10.6.0.0/24"
WORKLOAD_POD_CIDR="192.168.0.0/16"
WORKLOAD_SERVICE_CIDR="10.96.0.0/12"
WORKLOAD_DNS_NAMESERVER="1.1.1.1"
OPENSTACK_FAILURE_DOMAIN="nova"
WORKLOAD_SSH_KEY_NAME="openstack-k8s-workload"

# Local nested guests can report Node Ready well before Calico finishes its
# first datastore/dataplane convergence. Keep these bounded and local-only;
# cloud and bare-metal profiles must establish their own readiness budgets.
WORKLOAD_NODE_READY_TIMEOUT="10m"
WORKLOAD_CAPI_READY_TIMEOUT="15m"
WORKLOAD_CALICO_READY_TIMEOUT="60m"
WORKLOAD_CALICO_PROBE_TIMEOUT_SECONDS="120"
WORKLOAD_CALICO_STARTUP_FAILURE_THRESHOLD="180"

# M3 Cluster Autoscaler contract. The generic multi-architecture manifest is
# pinned by tag and digest; Docker Desktop selects the verified arm64 child.
CLUSTER_AUTOSCALER_VERSION="v1.35.0"
CLUSTER_AUTOSCALER_IMAGE_DIGEST="sha256:2fc9433dd3b47baef0e68d6b1110b770a3c93db10c7bead4c5bc6cb21c72b875"
CLUSTER_AUTOSCALER_ARM64_IMAGE_DIGEST="sha256:22cacc1f932484eab3ed12e09503f0d5efe472a92a9de915205aadd4fd66e6eb"
CLUSTER_AUTOSCALER_IMAGE="registry.k8s.io/autoscaling/cluster-autoscaler:v1.35.0@sha256:2fc9433dd3b47baef0e68d6b1110b770a3c93db10c7bead4c5bc6cb21c72b875"
CLUSTER_AUTOSCALER_NAMESPACE="cluster-autoscaler-system"
CLUSTER_AUTOSCALER_SERVICE_ACCOUNT="cluster-autoscaler"
CLUSTER_AUTOSCALER_WORKLOAD_NAMESPACE="kube-system"
CLUSTER_AUTOSCALER_WORKLOAD_TOKEN_SECRET="cluster-autoscaler-token"
CLUSTER_AUTOSCALER_WORKLOAD_KUBECONFIG_SECRET="cluster-autoscaler-workload-kubeconfig"
CLUSTER_AUTOSCALER_NODE_GROUP_MIN_SIZE="1"
CLUSTER_AUTOSCALER_NODE_GROUP_MAX_SIZE="2"
CLUSTER_AUTOSCALER_TEST_NAMESPACE="default"
CLUSTER_AUTOSCALER_TEST_NAME="m3-cpu-scale-up"
CLUSTER_AUTOSCALER_TEST_IMAGE="busybox:1.37.0"
CLUSTER_AUTOSCALER_TARGETED_PROBE_NAME="m3-new-worker-cni-dns"

# Actual SSH user inside the Ubuntu Lima guests.
TARGET_SSH_USER="ubuntu"
