# Source this file through ENV_OVERRIDE_FILE. The sibling local.env path is
# ignored by Git for a workstation-specific copy.
ENVIRONMENT_NAME="cloud-gcp-amd64-greenfield"
GCP_PROJECT_ID="replace-with-an-existing-billed-project"
GCP_REGION="asia-northeast3"
GCP_ZONE="asia-northeast3-a"
TARGET_SSH_USER="$(id -un)"

# New environment names automatically use isolated state below .state. Set an
# explicit path only when migrating or restoring a local state file.
# IAC_STATE_FILE="/absolute/path/to/terraform.tfstate"

# Supply one of these when running the client on a platform other than the
# verified Darwin/ARM64 baseline.
# CLUSTERCTL_DARWIN_AMD64_SHA256="..."
# CLUSTERCTL_LINUX_AMD64_SHA256="..."
# CLUSTERCTL_LINUX_ARM64_SHA256="..."
