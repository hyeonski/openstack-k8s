# shellcheck shell=bash
#
# GCP AMD64 evaluation profile. This file contains no secrets.

ENVIRONMENT_NAME="cloud-gcp-amd64"
ARCHITECTURE="x86_64"
HOST_PROVIDER="gcp"
EXPECTED_ANSIBLE_ARCHITECTURES="x86_64"

GCP_PROJECT_ID="openstack-k8s"
GCP_REGION="asia-northeast3"
GCP_ZONE="asia-northeast3-a"
GCP_NETWORK_NAME="osk8s-mgmt"
GCP_SUBNETWORK_NAME="osk8s-seoul"
GCP_USE_IAP_TUNNEL="yes"
GCP_OPENSTACK_FLOATING_IP_ROUTE_NAME="osk8s-openstack-floating-ips"

CONTROLLER_NAME="osk8s-controller"
CONTROLLER_MANAGEMENT_IP="10.20.0.10"
COMPUTE_NAME="osk8s-compute01"
COMPUTE_NAMES=("osk8s-compute01" "osk8s-compute02")
COMPUTE_INVENTORY_NAMES=("compute01" "compute02")
COMPUTE_NODE_HOSTNAMES=("osk8s-compute01" "osk8s-compute02")
COMPUTE_MANAGEMENT_IPS=("10.20.0.21" "10.20.0.22")
MANAGEMENT_INTERFACE="ens4"

TARGET_SSH_USER="hyeonseungkim"
GUEST_SWAP_GIB="2"

MANAGEMENT_CIDR="10.20.0.0/24"
KOLLA_INTERNAL_VIP_ADDRESS="10.20.0.250"

# A single logical Neutron external network is kept inside the controller.
# GCP VPC access to this range is enabled by a static route only after the
# controller external-network service is deployed and verified.
EXTERNAL_CIDR="172.24.4.0/24"
EXTERNAL_GATEWAY="172.24.4.1"
EXTERNAL_ALLOCATION_POOL_START="172.24.4.100"
EXTERNAL_ALLOCATION_POOL_END="172.24.4.199"
EXTERNAL_INTERFACE="veth-kolla-ex"
EXTERNAL_GATEWAY_INTERFACE="veth-kolla-gw"
EXTERNAL_PHYSNET="physnet1"
EXTERNAL_NETWORK_NAME="public"

TENANT_CIDR="10.10.0.0/24"
TENANT_GATEWAY="10.10.0.1"
TENANT_NETWORK_NAME="private"
TENANT_SUBNET_NAME="private-subnet"
TENANT_ROUTER_NAME="test-router"

KOLLA_SERIES="2025.2"
KOLLA_GIT_URL="https://github.com/openstack/kolla-ansible.git"
KOLLA_GIT_REF="34daacfbf2d5987f543787f57535b2bebe7dee19"
KOLLA_COLLECTION_GIT_URL="https://github.com/openstack/ansible-collection-kolla.git"
KOLLA_COLLECTION_GIT_REF="e5c055a07f7fe8c7632ea67d964c28c2b33c7575"
KOLLA_BASE_DISTRO="ubuntu"
KOLLA_OPENSTACK_TAG_SUFFIX=""
KOLLA_DEPLOY_DIR="/opt/openstack-k8s"
KOLLA_CONFIG_DIR="/etc/kolla"
KOLLA_VENV="/opt/kolla-venv"
KOLLA_GLOBALS_TEMPLATE="globals-cloud-gcp-amd64.yml.tpl"
KOLLA_BUILD_NOVA_LIBVIRT_OVERRIDE="no"

OPENSTACK_TEST_PROJECT="capi-test"
OPENSTACK_TEST_USER="capi-test"
OPENSTACK_TEST_FLAVOR="m1.gcp"
OPENSTACK_TEST_FLAVOR_VCPUS="1"
OPENSTACK_TEST_FLAVOR_RAM_MB="1024"
OPENSTACK_TEST_FLAVOR_DISK_GB="10"

CIRROS_VERSION="0.6.3"
CIRROS_IMAGE_NAME="cirros-0.6.3-x86_64"
CIRROS_IMAGE_URL="https://github.com/cirros-dev/cirros/releases/download/0.6.3/cirros-0.6.3-x86_64-disk.img"
CIRROS_SHA256_URL="https://github.com/cirros-dev/cirros/releases/download/0.6.3/SHA256SUMS"

UBUNTU_IMAGE_NAME="ubuntu-24.04-amd64"
UBUNTU_IMAGE_URL="https://cloud-images.ubuntu.com/releases/noble/release/ubuntu-24.04-server-cloudimg-amd64.img"
UBUNTU_SHA256_URL="https://cloud-images.ubuntu.com/releases/noble/release/SHA256SUMS"

# The AMD64 Kubernetes image builder and management-cluster topology are the
# next migration checkpoints. Values shared by manifests remain pinned here.
IMAGE_BUILDER_NAME="osk8s-image-builder"
IMAGE_BUILDER_MACHINE_TYPE="n2-standard-4"
IMAGE_BUILDER_DISK_GIB="80"
IMAGE_BUILDER_VERSION="v0.1.55"
IMAGE_BUILDER_COMMIT="7ffb9b7f1f26cd66891874463cc9411e3633325f"
KUBERNETES_VERSION="v1.35.7"
KUBERNETES_IMAGE_NAME="ubuntu-2204-kube-v1.35.7-amd64"
KUBERNETES_IMAGE_OS_VERSION="22.04"

# The management cluster runs on the Kolla controller without changing the
# daemon's bridge/iptables settings. A dedicated bridge and explicit NAT rules
# isolate kind, while the API remains reachable only through an IAP tunnel.
MANAGEMENT_RUNTIME_HOST_NAME="osk8s-controller"
MANAGEMENT_API_ADDRESS="10.20.0.10"
MANAGEMENT_REMOTE_API_PORT="16443"
MANAGEMENT_LOCAL_API_PORT="16443"
WORKLOAD_LOCAL_API_PORT="16444"
MANAGEMENT_DOCKER_NETWORK="kind"
MANAGEMENT_DOCKER_CIDR="172.30.0.0/24"
MANAGEMENT_DOCKER_BRIDGE="br-kind-mgmt"
MANAGEMENT_CLUSTER_NAME="osk8s-management"
KIND_VERSION="v0.31.0"
KIND_LINUX_AMD64_SHA256="eb244cbafcc157dff60cf68693c14c9a75c4e6e6fedaf9cd71c58117cb93e3fa"
KIND_NODE_IMAGE="kindest/node:v1.35.0@sha256:452d707d4862f52530247495d180205e029056831160e22870e37e3f6c1ac31f"
KIND_KUBERNETES_VERSION="v1.35.0"
MANAGEMENT_KUBERNETES_ARCHITECTURE="amd64"

KUBERNETES_CONTROL_PLANE_FLAVOR="k8s.control-plane.gcp"
KUBERNETES_CONTROL_PLANE_VCPUS="2"
KUBERNETES_CONTROL_PLANE_RAM_MB="2048"
KUBERNETES_CONTROL_PLANE_DISK_GB="20"

KUBERNETES_WORKER_FLAVOR="k8s.worker.gcp"
KUBERNETES_WORKER_VCPUS="2"
KUBERNETES_WORKER_RAM_MB="2048"
KUBERNETES_WORKER_DISK_GB="20"

PROBE_DOCKER_NETWORK="osk8s-capo-probe"
PROBE_API_PORT="6443"

WORKLOAD_NAMESPACE="osk8s-workload"
WORKLOAD_CLUSTER_NAME="osk8s-workload"
WORKLOAD_NETWORK_CIDR="10.6.0.0/24"
WORKLOAD_POD_CIDR="192.168.0.0/16"
WORKLOAD_SERVICE_CIDR="10.96.0.0/12"
WORKLOAD_DNS_NAMESERVER="1.1.1.1"
OPENSTACK_FAILURE_DOMAIN="nova"
WORKLOAD_SSH_KEY_NAME="openstack-k8s-workload"

WORKLOAD_NODE_READY_TIMEOUT="10m"
WORKLOAD_CAPI_READY_TIMEOUT="15m"
WORKLOAD_CALICO_READY_TIMEOUT="60m"
WORKLOAD_CALICO_PROBE_TIMEOUT_SECONDS="120"
WORKLOAD_CALICO_STARTUP_FAILURE_THRESHOLD="180"

CLUSTER_API_VERSION="v1.13.4"
CLUSTERCTL_DARWIN_ARM64_SHA256="923f15e5d78c1fb161fc32aa0fb69065ba063c4fa619ce80c2dfbb18c21a3f47"
CAPO_VERSION="v0.14.6"
ORC_VERSION="v2.4.0"
ORC_INSTALL_SHA256="f27d81872499ff9df5aa0278843d56b9b4d96e63a1c5823ebfca8af43587196b"
CALICO_VERSION="v3.32.1"
CALICO_MANIFEST_SHA256="a1df919d9721cf667accdc3e72848911b0cb25cfab7d2478ad0c996302c95744"
WORKLOAD_KUBERNETES_ARCHITECTURE="amd64"
CLUSTER_AUTOSCALER_VERSION="v1.35.0"
CLUSTER_AUTOSCALER_IMAGE_DIGEST="sha256:2fc9433dd3b47baef0e68d6b1110b770a3c93db10c7bead4c5bc6cb21c72b875"
CLUSTER_AUTOSCALER_IMAGE="registry.k8s.io/autoscaling/cluster-autoscaler:v1.35.0@sha256:2fc9433dd3b47baef0e68d6b1110b770a3c93db10c7bead4c5bc6cb21c72b875"
CLUSTER_AUTOSCALER_NAMESPACE="cluster-autoscaler-system"
CLUSTER_AUTOSCALER_SERVICE_ACCOUNT="cluster-autoscaler"
CLUSTER_AUTOSCALER_WORKLOAD_NAMESPACE="kube-system"
CLUSTER_AUTOSCALER_WORKLOAD_TOKEN_SECRET="cluster-autoscaler-token"
CLUSTER_AUTOSCALER_WORKLOAD_KUBECONFIG_SECRET="cluster-autoscaler-workload-kubeconfig"
CLUSTER_AUTOSCALER_NODE_GROUP_MIN_SIZE="1"
CLUSTER_AUTOSCALER_NODE_GROUP_MAX_SIZE="2"
CLUSTER_AUTOSCALER_TEST_NAMESPACE="default"
CLUSTER_AUTOSCALER_TEST_NAME="m3-cpu-scale-up"
CLUSTER_AUTOSCALER_TEST_IMAGE="busybox:1.37.0"
CLUSTER_AUTOSCALER_TARGETED_PROBE_NAME="m3-new-worker-cni-dns"
