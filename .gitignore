.DS_Store
config/environments/local.env

# Local state and secrets
.state/

# Generated run artifacts (sanitized results may be copied to results/)
artifacts/

# Python / Ansible local environments
.venv/
**/__pycache__/
*.pyc

# Generated Kolla and Ansible files
generated/
ansible/inventory/*/generated-hosts.ini
kolla/environments/*/generated/

# Temporary files
*.tmp
*.swp

# Terraform/OpenTofu local working data and state
**/.terraform/
**/.terraform.tfstate.lock.info
**/terraform.tfstate
**/terraform.tfstate.*
**/*.tfplan
crash.log
